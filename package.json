    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.2.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
